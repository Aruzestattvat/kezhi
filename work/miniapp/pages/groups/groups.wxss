.page { padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); }
.page-head .primary-button { min-width: 150rpx; min-height: 76rpx; font-size: 28rpx; }
.group-list { display: flex; flex-direction: column; gap: 16rpx; }
.group-card { display: flex; align-items: center; gap: 20rpx; padding: 26rpx; }
.group-avatar { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 22rpx; background: #dcedb5; color: #155b47; font-size: 30rpx; font-weight: 800; }
.group-copy { flex: 1; min-width: 0; }
.group-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 29rpx; font-weight: 700; }
.group-meta { display: block; margin-top: 9rpx; color: #849089; font-size: 22rpx; }
.group-delete { min-width: 100rpx; min-height: 64rpx; padding: 0 14rpx; background: #fff7f3; color: #a35142; border: 1rpx solid #ead7d0; font-size: 24rpx; line-height: 1.2; }
